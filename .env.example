# Local deterministic mode is the default.
MDX_ENV=local
MDX_BIND_ADDR=127.0.0.1:8787

# Local storage. Leave DATABASE_URL unset for deterministic local stubs or let
# scripts/local-postgres-env.sh select the local Docker Postgres port.
DATABASE_URL=

# Object storage. Local is the zero-configuration default. Production uses the
# same S3-compatible adapter for Supabase Storage, AWS S3, or another provider.
MDX_STORAGE_BACKEND=local
MDX_STORAGE_BUCKET=
MDX_STORAGE_REGION=
MDX_STORAGE_ENDPOINT=
MDX_STORAGE_CREDENTIAL_MODE=ambient
MDX_STORAGE_ACCESS_KEY_ID=
MDX_STORAGE_SECRET_ACCESS_KEY=
MDX_STORAGE_FORCE_PATH_STYLE=0
MDX_STORAGE_OPERATION_TIMEOUT_SECONDS=15
MDX_OBJECT_STORAGE_LIVE_ENABLED=0
MDX_OBJECT_STORAGE_BINARY_UPLOADS_ENABLED=0
MDX_STORAGE_TURN_ON_APPROVAL_RECEIPT_ID=

# Runtime substrate turn-on values. Leave unset for deterministic local stubs.
TEMPORAL_ADDRESS=
TENSORZERO_GATEWAY_URL=
MEM0_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional upstream model credentials. Do not set these for deterministic local proof.
MDX_DEFAULT_MODEL_PROVIDER=deterministic
MDX_OPENAI_MODEL=gpt-5-mini
MDX_ANTHROPIC_MODEL=claude-sonnet-4-5
MDX_XAI_MODEL=grok-4
MDX_MOONSHOT_MODEL=kimi-k3
MDX_GEMINI_MODEL=gemini-2.5-pro
MDX_MISTRAL_MODEL=mistral-large-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Canonical Model Access policy. Local defaults allow BYOK, managed, enterprise,
# and local runtimes. Production tenants should narrow both lists explicitly.
MDX_MODEL_ACCESS_MODES=byok,managed,enterprise,local
MDX_MODEL_PROVIDER_ALLOWLIST=
MDX_MODEL_MAX_LIVE_TEST_MICROUSD=100000
# Optional tenant-scoped secret adapters. Files are resolved below a hashed
# tenant directory and must be regular, non-symlink, non-writable files.
MDX_MODEL_SECRET_DIR=
MDX_MANAGED_MODEL_SECRET_DIR=
# Optional Vault or broker origin. HTTPS is required except on loopback.
MDX_MODEL_SECRET_BROKER_URL=
MDX_PROVIDER_TURN_ON_APPROVAL_RECEIPT_ID=
MDX_OPENAI_LIVE_TURN_ON=0

# Auth and SSO. Local stub auth is the default. Real auth must be turned on
# through an auth provider profile and tenant policy evidence.
MDX_AUTH_MODE=local
MDX_AUTH_PROVIDER=
MDX_AUTH_JWT_ISSUER=
MDX_AUTH_JWT_AUDIENCE=
MDX_AUTH_JWKS_URL=
MDX_AUTH_TENANT_CLAIM=
MDX_AUTH_ROLE_CLAIM=
MDX_AUTH_EMAIL_CLAIM=email
MDX_AUTH_GROUPS_CLAIM=
MDX_AUTH_SAML_METADATA_URL=
MDX_AUTH_COOKIE_SECRET=
MDX_GOOGLE_CLIENT_ID=
MDX_GOOGLE_CLIENT_SECRET=
MDX_MICROSOFT_CLIENT_ID=
MDX_MICROSOFT_CLIENT_SECRET=
MDX_MICROSOFT_TENANT_ID=
MDX_SUPABASE_URL=
MDX_SUPABASE_ANON_KEY=
MDX_SUPABASE_SERVICE_ROLE_KEY=

# Experience profile: which front door this deployment serves.
#   local       - no public marketing; "/" goes straight to setup (default on a machine)
#   public-beta - public landing + waitlist + invite redemption + pending room
#   enterprise  - no public marketing; every route requires the org's verified sign-in
# Unset, the profile is derived from MDX_PUBLIC_ROOT_MODE and MDX_DEPLOYMENT_MODE.
MDX_EXPERIENCE_PROFILE=
# Set to "landing" to serve the public landing at "/" (public-beta deployments).
MDX_PUBLIC_ROOT_MODE=

# Message relay. Production relay auth requires a secret and tenant-aware claims.
MDX_MESSAGE_RELAY_REQUIRE_AUTH=0
MDX_MESSAGE_RELAY_JWT_SECRET=

# Optional deployment credentials. Not used by local proof.
MDX_DEPLOYMENT_PROFILE=local
RENDER_API_KEY=
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_EKS_CLUSTER=
MDX_AWS_RDS_DATABASE_URL_SECRET_ARN=
MDX_AWS_RUNTIME_SECRET_ARN=
MDX_AWS_SECRETS_PREFIX=/mdx
GCP_PROJECT_ID=
GCP_REGION=
MDX_GCP_SECRET_PREFIX=/mdx
