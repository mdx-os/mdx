{
  "name": "mdx-talent-worker-credential-gate",
  "mode": "deterministic-local",
  "runtime_status": "DECLARED-LOCAL-AUTHORITY",
  "source": "docs/TALENT-WORKER-CREDENTIAL-GATE.md",
  "future_loop_runner_id": "talent_autonomy_agent",
  "credential_source": "generated/eval-suites/evals_runner_agent.json",
  "worker_credential_check_contract": "generated/workers/credential-check-contract.json",
  "authorization_envelope": "generated/talent/authorization-envelope.json",
  "credential_check_schema_path": "contracts/worker-credential-check.schema.json",
  "worker_spawn_contract": "generated/workers/spawn-request-contract.json",
  "provisioning_boundary": "generated/talent/provisioning-boundary.json",
  "required_before_spawn": ["eval_credential_id", "credential_receipt_id", "capability_scope", "expires_at", "issuer_loop_id"],
  "required_receipts": ["worker.credential.checked", "worker.spawn_requested"],
  "forbidden_paths": ["spawn_without_eval_credential", "reuse_expired_credential", "scope_mismatch", "credential_check_without_receipt"],
  "rules": [
    "Talent cannot spawn a worker until an eval-backed credential is checked",
    "Worker credential scope must match the requested worker capability",
    "Credential checks write receipts before worker.spawn_requested"
  ]
}
