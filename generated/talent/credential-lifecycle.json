{
  "name": "mdx-talent-credential-lifecycle",
  "mode": "deterministic-local",
  "runtime_status": "DECLARED-LOCAL-AUTHORITY",
  "future_loop_runner_id": "talent_autonomy_agent",
  "credential_source": "generated/eval-suites/evals_runner_agent.json",
  "worker_credential_gate": "generated/talent/worker-credential-gate.json",
  "worker_credential_check_contract": "generated/workers/credential-check-contract.json",
  "authorization_envelope": "generated/talent/authorization-envelope.json",
  "lifecycle_receipts": ["credential.issued", "credential.renewed", "credential.revoked", "credential.expired", "worker.credential.checked"],
  "required_issue_fields": ["eval_credential_id", "credential_receipt_id", "capability_scope", "issued_at", "expires_at", "issuer_loop_id"],
  "required_renewal_fields": ["previous_credential_id", "fresh_eval_verdict_id", "renewed_expires_at", "issuer_loop_id"],
  "required_revocation_fields": ["credential_id", "revocation_reason", "revoked_by", "revoked_at"],
  "spawn_blockers": ["expired_credential", "revoked_credential", "scope_mismatch", "missing_fresh_eval_verdict"],
  "rules": [
    "Credential issue precedes worker.credential.checked",
    "Credential renewal requires a fresh eval verdict",
    "Revoked or expired credentials cannot authorize worker spawn",
    "Credential lifecycle receipts are queryable before live worker execution is declared"
  ]
}
