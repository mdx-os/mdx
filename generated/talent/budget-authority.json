{
  "name": "mdx-talent-budget-authority",
  "mode": "deterministic-local",
  "runtime_status": "DECLARED-LOCAL-AUTHORITY",
  "source": "docs/TALENT-BUDGET-AUTHORITY.md",
  "future_loop_runner_id": "talent_autonomy_agent",
  "required_receipt_kind": "talent.budget.authorized",
  "required_before": ["talent.authorization.recorded", "worker.credential.checked", "worker.spawn_requested", "worker.handoff.recorded", "worker.retired"],
  "required_fields": ["tenant_id", "parent_loop_id", "requested_by_loop_id", "human_sponsor_chain", "budget_limit", "budget_unit", "scope", "expires_at", "policy_decision_id", "treasury_receipt_id"],
  "consumers": ["generated/talent/authorization-envelope.json"],
  "forbidden_paths": ["authorization_without_budget_authority", "worker_spawn_without_budget_authority", "budget_reuse_across_scope", "budget_reuse_across_tenant", "budget_without_treasury_receipt", "budget_without_policy_decision"],
  "rules": [
    "Talent cannot authorize worker spend from a bare numeric budget field",
    "Budget authority is bounded by tenant, parent loop, scope, expiry, and policy decision",
    "Treasury authority stays separate from Talent worker orchestration"
  ]
}
