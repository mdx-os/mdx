  "scenarios": [
    { "id": "all_authority_receipts_allows_spawn", "kind": "allowed", "must_include": ["sponsor_chain_authority_receipt_id", "worker_lease_authority_receipt_id", "budget_authority_receipt_id", "tool_allowlist_authority_receipt_id", "credential_check_receipt_id", "worker.spawn_requested"] },
