    { "id": "missing_budget_authority_blocks_spawn", "kind": "blocked", "missing": "budget_authority_receipt_id", "must_forbid": ["worker.spawn_requested"] },
    { "id": "missing_tool_allowlist_authority_blocks_spawn", "kind": "blocked", "missing": "tool_allowlist_authority_receipt_id", "must_forbid": ["worker.spawn_requested"] },
    { "id": "missing_credential_check_blocks_spawn", "kind": "blocked", "missing": "credential_check_receipt_id", "must_forbid": ["worker.spawn_requested"] },
    { "id": "expired_credential_blocks_spawn", "kind": "blocked", "hard_stop": "expires_at", "must_forbid": ["worker.spawn_requested"] },
    { "id": "scope_mismatch_blocks_spawn", "kind": "blocked", "hard_stop": "credential_scope", "must_forbid": ["worker.spawn_requested"] },
