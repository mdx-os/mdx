{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthSessionControlLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "writes_route", "projection_route", "control_id", "control_kind", "control_receipt_kind", "control_receipt_id", "policy_decision_id", "source_role_assignment_receipt_id", "source_session_activation_receipt_id", "target_actor_id", "current_role", "requested_role", "requested_tenant_id", "expires_at", "reason", "actor_admission_status", "session_activation_recorded", "session_revocation_recorded", "tenant_switch_refused", "role_escalation_refused", "session_cookie_write_allowed", "production_auth_provider_allowed", "production_role_write_allowed", "service_role_shortcut_allowed", "live_substrate_required", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-auth-session-control-local-post" },
    "status": { "enum": ["AUTH_SESSION_ACTIVATION_RECORDED_COOKIE_BLOCKED", "AUTH_SESSION_REVOCATION_RECORDED_PROVIDER_BLOCKED", "AUTH_TENANT_SWITCH_REFUSED_POLICY_REQUIRED", "AUTH_ROLE_ESCALATION_REFUSED_POLICY_REQUIRED"] },
    "auth_session_required": { "const": true },
    "auth_session_status": { "enum": ["ACCEPTED_LOCAL_STUB", "VERIFIED_TRUSTED_SESSION"] },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/auth/session-controls.json" },
    "projection_route": { "const": "/auth/session-controls/projection.json" },
    "control_id": { "type": "string", "minLength": 1 },
    "control_kind": { "enum": ["session_activation", "session_revocation", "tenant_switch_refusal", "role_escalation_refusal"] },
    "control_receipt_kind": { "enum": ["auth.session.activation.recorded", "auth.session.revocation.recorded", "auth.tenant_switch.refused", "auth.role_escalation.refused"] },
    "control_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "source_role_assignment_receipt_id": { "type": "string", "minLength": 1 },
    "source_session_activation_receipt_id": { "type": "string", "minLength": 1 },
    "target_actor_id": { "type": "string", "minLength": 1 },
    "current_role": { "type": "string", "minLength": 1 },
    "requested_role": { "type": "string", "minLength": 1 },
    "requested_tenant_id": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "actor_admission_status": { "type": "string", "minLength": 1 },
    "session_activation_recorded": { "type": "boolean" },
    "session_revocation_recorded": { "type": "boolean" },
    "tenant_switch_refused": { "type": "boolean" },
    "role_escalation_refused": { "type": "boolean" },
    "session_cookie_write_allowed": { "const": false },
    "production_auth_provider_allowed": { "const": false },
    "production_role_write_allowed": { "const": false },
    "service_role_shortcut_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
