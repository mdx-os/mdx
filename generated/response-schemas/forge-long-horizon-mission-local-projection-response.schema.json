{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeLongHorizonMissionLocalProjectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "route", "writes_route", "checkpoint_route", "dashboard_route", "mission_count", "active_mission_count", "live_provider_calls_allowed", "adapter_execution_allowed", "production_write_allowed", "missions"],
  "properties": {
    "name": { "const": "mdx-forge-long-horizon-mission-local-projection" },
    "status": { "const": "OK" },
    "route": { "const": "/forge/long-horizon-missions/projection.json" },
    "writes_route": { "const": "/forge/long-horizon-missions.json" },
    "checkpoint_route": { "const": "/forge/long-horizon-mission-checkpoints.json" },
    "dashboard_route": { "const": "/forge/long-horizon-mission-dashboard.json" },
    "mission_count": { "type": "integer", "minimum": 0 },
    "active_mission_count": { "type": "integer", "minimum": 0 },
    "live_provider_calls_allowed": { "const": false },
    "adapter_execution_allowed": { "const": false },
    "production_write_allowed": { "const": false },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["mission_id", "goal", "done_when", "validation_commands", "model_policy", "provider_allowlist", "fleet_width", "mission_receipt_id", "policy_decision_id", "milestones"],
        "properties": {
          "mission_id": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "done_when": { "type": "string", "minLength": 1 },
          "validation_commands": { "type": "string", "minLength": 1 },
          "model_policy": { "const": "mdx_approved_responses_compatible_provider_profiles_only" },
          "provider_allowlist": { "type": "string", "minLength": 1 },
          "fleet_width": { "type": "integer", "minimum": 1 },
          "mission_receipt_id": { "type": "string", "minLength": 1 },
          "policy_decision_id": { "type": "string", "minLength": 1 },
          "mission_state": { "type": "string", "minLength": 1 },
          "checkpoint_count": { "type": "integer", "minimum": 0 },
          "completed_milestone_count": { "type": "integer", "minimum": 0 },
          "blocked_milestone_count": { "type": "integer", "minimum": 0 },
          "milestones": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
