{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservatoryReadModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "latest_run",
    "receipt_ids",
    "receipt_count",
    "policy_decision_count",
    "eval_verdict_count",
    "credential_count",
    "charter_record_count",
    "memory_record_count",
    "role_modes",
    "declared_sources"
  ],
  "properties": {
    "surface": { "const": "observatory" },
    "latest_run": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["loop_id", "status"],
          "properties": {
            "loop_id": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      ]
    },
    "receipt_ids": { "type": "array", "items": { "type": "string" } },
    "receipt_count": { "type": "integer", "minimum": 0 },
    "policy_decision_count": { "type": "integer", "minimum": 0 },
    "eval_verdict_count": { "type": "integer", "minimum": 0 },
    "credential_count": { "type": "integer", "minimum": 0 },
    "charter_record_count": { "type": "integer", "minimum": 0 },
    "memory_record_count": { "type": "integer", "minimum": 0 },
    "role_modes": { "type": "array", "items": { "type": "string" } },
    "declared_sources": { "type": "array", "items": { "type": "string" } }
  }
}
