{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeFleetEvalProviderPreflightResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "route", "approval_route", "scoreboard_route", "tenant_id", "provider_count", "ready_provider_count", "all_credentials_present", "provider_secret_values_exposed", "provider_secret_values_recorded", "provider_secret_export_allowed", "live_eval_runs_allowed", "approval_required", "requirements"],
  "properties": {
