{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageActionRequestLocalProjectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_route", "writes_route", "verdicts_route", "action_request_count", "allowed_verdicts", "execution_allowed", "live_substrate_required", "production_write_allowed", "requests"],
  "properties": {
    "name": { "const": "mdx-message-action-request-local-projection" },
    "status": { "const": "OK" },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/messages/action-requests.json" },
    "verdicts_route": { "const": "/messages/action-verdicts.json" },
    "action_request_count": { "type": "integer", "minimum": 0 },
    "allowed_verdicts": { "const": "approve,edit,reject,respond" },
    "execution_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false },
    "requests": { "type": "array" }
  }
}
