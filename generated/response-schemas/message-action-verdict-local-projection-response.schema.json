{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageActionVerdictLocalProjectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_route", "writes_route", "action_verdict_count", "execution_allowed", "live_substrate_required", "production_write_allowed", "verdicts"],
  "properties": {
    "name": { "const": "mdx-message-action-verdict-local-projection" },
    "status": { "const": "OK" },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/messages/action-verdicts.json" },
    "action_verdict_count": { "type": "integer", "minimum": 0 },
    "execution_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_verdict_id", "action_verdict_receipt_id", "action_request_receipt_id", "action_request_id", "verdict", "gate_state", "applied_receipt_kind", "applied_receipt_id", "human_decision_recorded", "human_approval_granted", "execution_allowed", "production_write_allowed"],
        "properties": {
          "action_verdict_id": { "type": "string" },
          "action_verdict_receipt_id": { "type": "string" },
          "policy_decision_id": { "type": "string" },
          "action_request_receipt_id": { "type": "string" },
          "action_request_id": { "type": "string" },
          "thread_id": { "type": "string" },
          "channel_id": { "type": "string" },
          "title": { "type": "string" },
          "verdict": { "enum": ["approve", "edit", "reject", "respond"] },
          "decision_note": { "type": "string" },
          "gate_state": { "type": "string" },
          "applied_receipt_kind": { "type": "string" },
          "applied_receipt_id": { "type": "string" },
          "human_decision_recorded": { "const": true },
          "human_approval_granted": { "type": "boolean" },
          "execution_allowed": { "const": false },
          "production_write_allowed": { "const": false }
        }
      }
    }
  }
}
