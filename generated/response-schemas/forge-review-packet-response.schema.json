          "additionalProperties": false,
          "required": ["generated_from", "readiness_status", "medium_high_work_ready", "safe_next_move", "semantic_orientation_operations", "proof_strategy", "first_run_task_ids", "scout_status", "scout_candidate_count", "scout_candidate_kinds", "scout_candidate_paths", "write_scope_hint", "off_limits_patterns", "review_focus", "source_host", "origin_url_present", "origin_url_recorded", "source_host_readiness_route", "source_host_pr_draft_route", "provider_calls_allowed", "run_started", "network_call_allowed", "production_write_allowed", "grants_execution_authority"],
          "properties": {
            "generated_from": { "enum": ["repo_readiness+repo_task_scout+language_task_alignment", ""] },
            "readiness_status": { "type": "string" },
            "medium_high_work_ready": { "type": "boolean" },
            "safe_next_move": { "type": "string" },
            "semantic_orientation_operations": { "type": "array", "items": { "enum": ["capabilities", "orientation", "workspace_symbol", "definition", "references", "impact_radius", "hover", "file_outline", "related_tests", "diagnostics", "lsp_probe"] } },
            "proof_strategy": { "type": "string" },
            "first_run_task_ids": { "type": "array", "items": { "type": "string" } },
            "scout_status": { "type": "string" },
            "scout_candidate_count": { "type": "integer", "minimum": 0 },
            "scout_candidate_kinds": { "type": "array", "items": { "enum": ["todo_cleanup", "untested_public_symbol", "error_boundary", "deprecated_api", "contained_refactor"] } },
            "scout_candidate_paths": { "type": "array", "items": { "type": "string" } },
            "write_scope_hint": { "type": "array", "items": { "type": "string" } },
            "off_limits_patterns": { "type": "array", "items": { "type": "string" } },
            "review_focus": { "type": "array", "items": { "type": "string" } },
            "source_host": { "type": "string" },
            "origin_url_present": { "type": "boolean" },
            "origin_url_recorded": { "const": false },
            "source_host_readiness_route": { "enum": ["/forge/source-host-readiness.json", ""] },
            "source_host_pr_draft_route": { "enum": ["/forge/source-host-pr-drafts.json", ""] },
            "provider_calls_allowed": { "const": false },
            "run_started": { "type": "boolean" },
            "network_call_allowed": { "const": false },
            "production_write_allowed": { "const": false },
            "grants_execution_authority": { "const": false }
          }
        },
        "principal_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generated_from", "checklist", "handoff_lines", "authority_note"],
          "properties": {
            "generated_from": { "const": "repo_intelligence+checks+diff" },
            "checklist": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "status", "line", "evidence"],
                "properties": {
                  "kind": { "enum": ["checks", "repo_intake", "work_classification", "language_task_alignment", "review_axis", "principal_review_gate", "language_pack_guidance", "semantic_intelligence", "semantic_session", "semantic_preflight", "principal_orientation_gate", "semantic_query_operations", "semantic_tool_readiness", "toolchain_readiness", "standards_sources", "standards_obligations", "diff_shape", "artifact_noise", "authority"] },
                  "status": { "enum": ["open", "satisfied", "attention"] },
                  "line": { "type": "string", "minLength": 1 },
                  "evidence": { "type": "object" }
                }
              }
            },
            "handoff_lines": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
            "authority_note": { "const": "Repo intelligence improves planning and review only. It does not grant execution authority, replace checks, or mark work passed." }
          }
        },
        "pr_handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generated_from", "title", "body_markdown", "summary_lines", "review_checklist", "candidate_recommendation", "review_packet_route", "production_write_allowed"],
          "properties": {
            "generated_from": { "const": "review_packet+repo_intelligence+diff" },
            "title": { "type": "string", "minLength": 1 },
            "body_markdown": { "type": "string", "minLength": 1 },
            "summary_lines": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
            "review_checklist": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "candidate_recommendation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["generated_from", "candidate_count", "current_run_id", "recommended_run_id", "current_rank", "current_run_is_recommended", "current_score", "recommended_score", "comparison_basis", "diff_quality_included", "eval_evidence_included", "model_judgment_included", "grants_execution_authority"],
              "properties": {
                "generated_from": { "const": "candidate_comparison" },
                "candidate_count": { "type": "integer", "minimum": 1 },
                "current_run_id": { "type": "string" },
                "recommended_run_id": { "type": "string" },
                "current_rank": { "type": "integer", "minimum": 1 },
                "current_run_is_recommended": { "type": "boolean" },
                "current_score": { "type": ["integer", "null"] },
                "recommended_score": { "type": ["integer", "null"] },
                "comparison_basis": {
                  "type": "array",
                  "items": { "enum": ["terminal_status", "selected_check_events", "semantic_orientation", "check_failures", "turn_count", "deterministic_diff_quality", "quarantined_eval_evidence"] }
                },
                "diff_quality_included": { "const": true },
                "eval_evidence_included": { "const": true },
                "model_judgment_included": { "const": false },
                "grants_execution_authority": { "const": false }
              }
            },
            "review_packet_route": { "const": "/forge/review-packet.json" },
            "production_write_allowed": { "const": false }
          }
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_count", "real_change_count", "generated_count", "artifact_count", "artifact_summary", "artifact_files_sample", "language_pack_impact", "added_total", "removed_total", "order", "sections"],
          "properties": {
            "file_count": { "type": "integer", "minimum": 0 },
            "real_change_count": { "type": "integer", "minimum": 0 },
            "generated_count": { "type": "integer", "minimum": 0 },
            "artifact_count": { "type": "integer", "minimum": 0 },
            "artifact_summary": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["reason", "count", "added", "removed", "sample_paths"], "properties": { "reason": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "sample_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
            "artifact_files_sample": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "added", "removed", "reason"], "properties": { "path": { "type": "string", "minLength": 1 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "reason": { "type": "string", "minLength": 1 } } } },
            "language_pack_impact": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["language_pack_id", "file_count", "added", "removed", "generated_count", "sample_paths"], "properties": { "language_pack_id": { "type": "string", "minLength": 1 }, "file_count": { "type": "integer", "minimum": 1 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "generated_count": { "type": "integer", "minimum": 0 }, "sample_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
            "added_total": { "type": "integer", "minimum": 0 },
            "removed_total": { "type": "integer", "minimum": 0 },
            "order": { "type": "array", "items": { "type": "string" } },
            "sections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["section", "label", "order", "file_count", "added", "removed", "generated", "files"], "properties": { "section": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "file_count": { "type": "integer", "minimum": 0 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "generated": { "type": "boolean" }, "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "added", "removed"], "properties": { "path": { "type": "string", "minLength": 1 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 } } } } } } }
          }
        },
        "ship": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decided", "reason", "receipt_id"],
          "properties": {
            "decided": { "type": "boolean" },
            "reason": { "type": "string" },
            "receipt_id": { "type": "string" }
          }
        },
        "panel": {
          "type": ["object", "null"]
        },
        "diff_route": { "const": "/forge/run-diff.json" },
        "panel_route": { "const": "/forge/review-panel.json" },
        "declared_not_built": {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicted_outcome", "response_schema"],
          "properties": {
            "predicted_outcome": { "type": "string", "minLength": 1 },
            "response_schema": { "const": "generated/response-schemas/forge-review-packet-response.schema.json" }
          }
        },
        "production_write_allowed": { "const": false }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason", "production_write_allowed"],
      "properties": {
        "name": { "const": "mdx-forge-review-packet" },
        "status": { "const": "REFUSED" },
        "reason": { "type": "string", "minLength": 1 },
        "production_write_allowed": { "const": false }
      }
    }
  ]
}
