{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeShipDecisionLocalProjectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_route", "writes_route", "ship_decision_count", "deployment_authority_granted", "deployment_allowed", "live_substrate_required", "production_write_allowed", "decisions"],
  "properties": {
    "name": { "const": "mdx-forge-ship-decision-local-projection" },
    "status": { "const": "OK" },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/forge/ship-decisions.json" },
    "ship_decision_count": { "type": "integer", "minimum": 0 },
    "deployment_authority_granted": { "const": false },
    "deployment_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_receipt_id", "policy_decision_id", "decision", "terminal_state", "denied_reason", "forge_ship_ratified", "ship_authority_allowed", "deployment_authority_granted", "deployment_allowed", "production_write_allowed"],
        "properties": {
          "decision_receipt_id": { "type": "string" },
          "policy_decision_id": { "type": "string" },
          "decision": { "type": "string" },
          "terminal_state": { "type": "string" },
          "denied_reason": { "type": "string" },
          "forge_ship_ratified": { "type": "boolean" },
          "ship_authority_allowed": { "type": "boolean" },
          "deployment_authority_granted": { "const": false },
          "deployment_allowed": { "const": false },
          "production_write_allowed": { "const": false }
        }
      }
    }
  }
}
