{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalOperationalHandoffResponse",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "mode", "status", "handoff_status", "observed_at", "git", "activation", "dogfood", "local_surfaces", "auth_session", "live_substrates", "local_driver_ports", "next_commands", "evidence_file", "notes"],
  "properties": {
    "name": { "const": "mdx-local-operational-handoff" },
    "mode": { "const": "local-only-ignored" },
    "status": { "const": "OK" },
    "handoff_status": { "const": "LOCAL-READY" },
    "observed_at": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "required": ["revision", "branch", "dirty"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    },
    "activation": {
      "type": "object",
      "required": ["complete", "runtime_loops", "http_routes", "receipt_backed_routes", "served_ui_apps", "dev_stack_apps", "provider_evidence_receipts"],
      "properties": {
        "complete": { "type": "boolean" },
        "runtime_loops": { "type": "integer", "minimum": 0 },
        "http_routes": { "type": "integer", "minimum": 0 },
        "receipt_backed_routes": { "type": "integer", "minimum": 0 },
        "served_ui_apps": { "type": "integer", "minimum": 0 },
        "dev_stack_apps": { "type": "integer", "minimum": 0 },
        "provider_evidence_receipts": { "type": "integer", "minimum": 0 }
      }
    },
    "dogfood": {
      "type": "object",
      "required": ["readiness", "full_dogfood_pass", "missing_for_full_dogfood", "forge", "charter", "talent", "pages"],
      "properties": {
        "readiness": { "const": "LOCAL-COMPLETE" },
        "full_dogfood_pass": { "type": "boolean" },
        "missing_for_full_dogfood": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forge": { "type": "string", "minLength": 1 },
        "charter": { "type": "string", "minLength": 1 },
        "talent": { "type": "string", "minLength": 1 },
        "pages": { "type": "string", "minLength": 1 }
      }
    },
    "local_surfaces": {
      "type": "object",
      "required": ["evidence_index", "activation_summary", "dogfood_proof", "evidence_report_command", "ready_check_command", "dev_stack_command"],
      "properties": {
        "evidence_index": { "const": ".mdx-local/evidence-index.json" },
        "activation_summary": { "const": ".mdx-local/activation-summary.json" },
        "dogfood_proof": { "const": ".mdx-local/dogfood/local-dogfood-proof.json" },
        "evidence_report_command": { "const": "make local-evidence-report" },
        "ready_check_command": { "const": "make local-ready-check" },
        "dev_stack_command": { "const": "make local-dev-stack" }
      }
    },
    "auth_session": {
      "type": "object",
      "required": ["route", "status", "tenant_id", "source"],
      "properties": {
        "route": { "const": "/local/auth-session.json" },
        "status": { "const": "deterministic-local-stub" },
        "tenant_id": { "const": "local_tenant" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "forge_operator": { "type": "object" },
    "live_substrates": {
      "type": "object",
      "required": ["live_local", "pending_live_run", "pending"],
      "properties": {
        "live_local": { "type": "integer", "minimum": 1 },
        "pending_live_run": { "type": "integer", "minimum": 5 },
        "pending": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["substrate", "next", "blockers"],
            "properties": {
              "substrate": { "type": "string", "minLength": 1 },
              "next": { "const": "make live-turn-on-check" },
              "blockers": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "local_driver_ports": {
      "type": "object",
      "required": ["status", "conformance_count", "model_gateway", "memory_store", "workflow_runner", "observability_trace_exporter", "proof_command", "notes"],
      "properties": {
        "status": { "const": "READY-LOCAL-DECISION" },
        "conformance_count": { "const": 4 },
        "model_gateway": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "memory_store": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "workflow_runner": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "observability_trace_exporter": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "proof_command": { "const": "make harness-runway-check" },
        "notes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_commands": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" },
      "allOf": [
        { "contains": { "const": "make local-ready-check" } },
        { "contains": { "const": "make operational-proof" } },
        { "contains": { "const": "make live-turn-on-check" } }
      ]
    },
    "evidence_file": { "const": ".mdx-local/handoff/local-operational-handoff.json" },
    "notes": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "contains": { "const": "non-Postgres live substrates remain PENDING-LIVE-RUN" }
    }
  }
}
