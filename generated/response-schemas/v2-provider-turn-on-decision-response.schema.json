{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2ProviderTurnOnDecisionResponse",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "mode",
    "status",
    "route",
    "read_only",
    "local_only_ready",
    "provider_connected_local_allowed_now",
    "provider_call_allowed_now",
    "live_provider_call_allowed_now",
    "live_network_allowed_now",
    "provider_secret_values_recorded",
    "requested_secret_values_recorded",
    "human_approval_required",
    "human_approval_receipt_required",
    "turn_on_receipt_required",
    "production_write_allowed",
    "deployment_authority_allowed",
    "proof_check",
    "route_check",
    "upstream_matrix_check",
    "upstream_activation_check",
    "provider_turn_on_check",
    "candidate_count",
    "env_ready_candidate_count",
    "ready_for_live_call_count",
    "recommended_first_candidate_id",
    "recommended_first_action",
    "local_fallback",
    "activation_candidates",
    "blocked_authority",
    "evidence_file"
  ],
  "properties": {
    "name": { "const": "mdx-v2-provider-turn-on-decision" },
    "mode": { "const": "local-first-provider-decision" },
    "status": { "enum": ["PROVIDER_TURN_ON_DECISION_READY", "NOT_READY"] },
    "route": { "const": "/v2/provider-turn-on-decision.json" },
    "read_only": { "const": true },
    "local_only_ready": { "const": true },
    "provider_connected_local_allowed_now": { "type": "boolean" },
    "provider_call_allowed_now": { "type": "boolean" },
    "live_provider_call_allowed_now": { "type": "boolean" },
    "live_network_allowed_now": { "type": "boolean" },
    "provider_secret_values_recorded": { "const": false },
    "requested_secret_values_recorded": { "const": false },
    "human_approval_required": { "const": true },
    "human_approval_receipt_required": { "const": true },
    "turn_on_receipt_required": { "const": true },
    "production_write_allowed": { "const": false },
    "deployment_authority_allowed": { "const": false },
    "proof_check": { "const": "make v2-provider-turn-on-decision" },
    "route_check": { "const": "make v2-provider-turn-on-decision-route-check" },
    "upstream_matrix_check": { "const": "make v2-provider-turn-on-matrix" },
    "upstream_activation_check": { "const": "make v2-provider-activation-request" },
    "provider_turn_on_check": { "const": "make live-turn-on-check" },
    "candidate_count": { "const": 6 },
    "env_ready_candidate_count": { "type": "integer", "minimum": 0 },
    "ready_for_live_call_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "first_provider_turn_on": {
      "type": "object",
      "required": ["status", "provider", "adapter", "receipt_kind", "observed", "provider_connected_local_allowed", "evidence_file", "proof_command"],
      "properties": {
        "status": { "enum": ["OPENAI_PROVIDER_TURN_ON_OBSERVED", "NOT_OBSERVED"] },
        "provider": { "const": "openai" },
        "adapter": { "const": "OpenAIResponsesModelGateway" },
        "receipt_kind": { "const": "openai.response.observed" },
        "observed": { "type": "boolean" },
        "provider_connected_local_allowed": { "type": "boolean" },
        "evidence_file": { "const": ".mdx-local/provider-turn-on/openai-response-observed.json" },
        "proof_command": { "const": "make v2-openai-provider-turn-on" }
      }
    },
    "recommended_first_candidate_id": { "type": "string", "minLength": 1 },
    "recommended_first_action": { "enum": ["capture_human_approval_and_run_live_turn_on_check", "provide_optional_provider_environment"] },
    "local_fallback": {
      "type": "object",
      "required": ["status", "proof", "model_gateway", "memory_store", "workflow_runner"],
      "properties": {
        "status": { "const": "LOCAL_ONLY_READY" },
        "proof": { "const": "make v2-fresh-install-proof" },
        "model_gateway": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "memory_store": { "const": "LIVE-LOCAL-CONFORMANCE" },
        "workflow_runner": { "const": "LIVE-LOCAL-CONFORMANCE" }
      }
    },
    "activation_candidates": {
      "type": "array",
      "minItems": 6,
      "contains": {
        "type": "object",
        "required": ["id", "substrate", "profile_kind", "status", "candidate_state", "env_ready", "missing_env_names", "credential_presence_only", "credential_values_recorded", "requested_secret_value_recorded", "required_receipt_kind", "human_approval_required", "human_approval_receipt_required", "turn_on_receipt_required", "provider_call_allowed_now", "live_provider_call_allowed_now", "turn_on_allowed_now", "live_network_allowed_now", "proof_command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "substrate": { "type": "string", "minLength": 1 },
          "profile_kind": { "type": "string", "minLength": 1 },
          "status": { "enum": ["READY_FOR_HUMAN_APPROVAL_RECEIPT", "WAITING_FOR_CREDENTIALS"] },
          "candidate_state": { "enum": ["READY_FOR_APPROVAL_RECEIPT", "WAITING_FOR_ENV"] },
          "env_ready": { "type": "boolean" },
          "missing_env_names": { "type": "array", "items": { "type": "string" } },
          "credential_presence_only": { "const": true },
          "credential_values_recorded": { "const": false },
          "requested_secret_value_recorded": { "const": false },
          "required_receipt_kind": { "type": "string", "minLength": 1 },
          "human_approval_required": { "const": true },
          "human_approval_receipt_required": { "const": true },
          "turn_on_receipt_required": { "const": true },
          "provider_call_allowed_now": { "const": false },
          "live_provider_call_allowed_now": { "const": false },
          "turn_on_allowed_now": { "const": false },
          "live_network_allowed_now": { "const": false },
          "proof_command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocked_authority": {
      "type": "object",
      "required": ["provider_call_without_turn_on_receipt_allowed", "live_network_without_approval_allowed", "secret_value_recording_allowed", "production_write_allowed", "deployment_authority_allowed"],
      "properties": {
        "provider_call_without_turn_on_receipt_allowed": { "const": false },
        "live_network_without_approval_allowed": { "const": false },
        "secret_value_recording_allowed": { "const": false },
        "production_write_allowed": { "const": false },
        "deployment_authority_allowed": { "const": false }
      }
    },
    "evidence_file": { "const": ".mdx-local/v2-provider-turn-on-decision.json" }
  }
}