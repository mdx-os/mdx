{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeWorkClassificationLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "writes_route", "projection_route", "run_route", "mission_route", "scoreboard_route", "dashboard_route", "classification_id", "classification_receipt_id", "policy_decision_id", "ask", "repo", "recommended_shape", "recommended_width", "recommendation_label", "recommendation_reason", "next_route", "next_gate", "adjustable_fields", "new_project_supported", "task_class", "complexity_tier", "confidence_pct", "rationale", "suggested_checks", "allowed_write_scope", "blocked_paths", "mission_recommended", "strategy", "strategy_execution_readiness", "classification_grants_execution_authority", "live_provider_calls_allowed", "adapter_execution_allowed", "production_write_allowed", "blocked_reason", "live_substrate_required"],
  "properties": {
    "name": { "const": "mdx-forge-work-classification-local-post" },
    "status": { "const": "FORGE_WORK_CLASSIFICATION_RECORDED" },
    "auth_session_required": { "const": true },
    "auth_session_status": { "type": "string", "minLength": 1 },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/forge/work-classifications.json" },
    "projection_route": { "const": "/forge/work-classifications/projection.json" },
    "run_route": { "const": "/forge/runs.json" },
    "mission_route": { "const": "/forge/long-horizon-missions.json" },
    "scoreboard_route": { "const": "/forge/fleet-eval-scoreboard.json" },
    "dashboard_route": { "const": "/forge/long-horizon-mission-dashboard.json" },
    "classification_id": { "type": "string", "minLength": 1 },
    "classification_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "ask": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "recommended_shape": { "enum": ["run", "mission"] },
    "recommended_width": { "type": "integer", "minimum": 1, "maximum": 128 },
    "recommendation_label": { "type": "string", "minLength": 1 },
    "recommendation_reason": { "type": "string", "minLength": 1 },
    "next_route": { "enum": ["/forge/runs.json", "/forge/fleet-plans.json", "/forge/long-horizon-missions.json"] },
    "next_gate": { "enum": ["run_start", "fleet_plan_ratification", "mission_admission"] },
    "adjustable_fields": { "type": "string", "minLength": 1 },
    "new_project_supported": { "const": false },
    "task_class": { "enum": ["bug_fix", "feature", "refactor", "security", "ci_repair", "docs_code", "multi_file", "architecture", "api_compat", "migration", "performance", "concurrency", "observability", "product_ux", "long_horizon"] },
    "complexity_tier": { "enum": ["small", "medium", "large", "xl", "extreme"] },
    "confidence_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rationale": { "type": "string", "minLength": 1 },
    "suggested_checks": { "type": "string", "minLength": 1 },
    "allowed_write_scope": { "type": "string", "minLength": 1 },
    "blocked_paths": { "type": "string", "minLength": 1 },
    "mission_recommended": { "type": "boolean" },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "outcome_preference", "execution_shape", "width", "harness_id", "harness_source", "planner_mode", "planner_source", "review_mode", "review_source", "advisor_mode", "max_turns", "max_cost_cents", "max_runtime_ms", "operator_locked_fields", "policy_floor_fields", "rationale", "grants_execution_authority"],
      "properties": {
        "version": { "const": "forge_run_strategy_v1" },
        "mode": { "enum": ["auto", "custom"] },
        "outcome_preference": { "enum": ["balanced", "faster", "confidence"] },
        "execution_shape": { "enum": ["run", "candidates", "fleet", "mission"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 512 },
        "harness_id": { "enum": ["mdx_native", "codex_cli", "grok_build"] },
        "harness_source": { "enum": ["native_learning_default", "operator_override"] },
        "planner_mode": { "enum": ["skip", "bounded", "required"] },
        "planner_source": { "enum": ["adaptive_policy", "operator_override", "policy_floor"] },
        "review_mode": { "enum": ["deterministic_only", "conditional_independent", "required_independent"] },
        "review_source": { "enum": ["adaptive_policy", "operator_override", "policy_floor"] },
        "advisor_mode": { "enum": ["skip", "eligible_on_trigger"] },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_cost_cents": { "type": "integer", "minimum": 1 },
        "max_runtime_ms": { "type": "integer", "minimum": 1 },
        "operator_locked_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "policy_floor_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 1 },
        "grants_execution_authority": { "const": false }
      }
    },
    "strategy_execution_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ready", "reason", "setup_required", "clearance_route", "approval_route", "cost_enforcement"],
      "properties": {
        "status": { "enum": ["READY", "SETUP_REQUIRED"] },
        "ready": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "setup_required": { "type": "boolean" },
        "clearance_route": { "type": "string" },
        "approval_route": { "type": "string" },
        "cost_enforcement": { "enum": ["priced_token_meter", "approval_ceiling_plus_turn_and_runtime_bounds_usage_metering_unavailable", "approval_ceiling_plus_runtime_and_scope_bounds_usage_and_turn_metering_unavailable"] }
      }
    },
    "classification_grants_execution_authority": { "const": false },
    "live_provider_calls_allowed": { "const": false },
    "adapter_execution_allowed": { "const": false },
    "production_write_allowed": { "const": false },
    "blocked_reason": { "const": "classification_recorded_waiting_for_operator_confirmation" },
    "live_substrate_required": { "const": false }
  }
}
