{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageActionRequestLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "auth_session_tenant_id", "auth_session_user_id", "auth_session_role", "writes_route", "projection_route", "verdicts_route", "action_request_id", "action_request_receipt_id", "message_receipt_id", "policy_decision_id", "thread_id", "channel_id", "source_receipt_id", "source_receipt_kind", "title", "summary", "proposed_action", "allowed_verdicts", "gate_state", "execution_allowed", "live_substrate_required", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-message-action-request-local-post" },
    "status": { "const": "MESSAGE_ACTION_REQUEST_RECORDED_EXECUTION_BLOCKED" },
    "auth_session_required": { "const": true },
    "auth_session_status": { "enum": ["ACCEPTED_LOCAL_STUB", "VERIFIED_TRUSTED_SESSION"] },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "auth_session_tenant_id": { "type": "string", "minLength": 1 },
    "auth_session_user_id": { "type": "string", "minLength": 1 },
    "auth_session_role": { "type": "string", "minLength": 1 },
    "writes_route": { "const": "/messages/action-requests.json" },
    "projection_route": { "const": "/messages/action-requests/projection.json" },
    "verdicts_route": { "const": "/messages/action-verdicts.json" },
    "action_request_id": { "type": "string", "minLength": 1 },
    "action_request_receipt_id": { "type": "string", "minLength": 1 },
    "message_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "channel_id": { "type": "string", "minLength": 1 },
    "source_receipt_id": { "type": "string", "minLength": 1 },
    "source_receipt_kind": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "proposed_action": { "type": "string", "minLength": 1 },
    "allowed_verdicts": { "const": "approve,edit,reject,respond" },
    "gate_state": { "const": "WAITING_FOR_HUMAN_VERDICT" },
    "execution_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
