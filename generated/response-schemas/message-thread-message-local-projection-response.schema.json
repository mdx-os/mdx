{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageThreadMessageLocalProjectionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_route", "writes_route", "message_count", "llm_allowed_on_hot_path", "realtime_fanout_allowed", "live_substrate_required", "production_write_allowed", "messages"],
  "properties": {
    "name": { "const": "mdx-message-thread-message-local-projection" },
    "status": { "const": "OK" },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "writes_route": { "const": "/messages/thread-messages.json" },
    "message_count": { "type": "integer", "minimum": 0 },
    "llm_allowed_on_hot_path": { "const": false },
    "realtime_fanout_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread_id", "channel_id", "message_id", "message_receipt_id", "message_receipt_kind", "policy_decision_id", "actor_id", "actor_type", "actor_display_name", "actor_role", "content_type", "body", "content_payload", "source_receipt_id", "source_receipt_kind", "trusted_context_citation", "trusted_context_source_id", "trusted_context_receipt_id", "trusted_context_projection_route", "outbox_topic", "sequence", "created_at", "llm_allowed_on_hot_path", "realtime_fanout_allowed", "production_write_allowed"],
        "properties": {
          "thread_id": { "type": "string" },
          "channel_id": { "type": "string" },
          "message_id": { "type": "string" },
          "message_receipt_id": { "type": "string" },
          "message_receipt_kind": { "enum": ["message.human.posted", "message.agent.posted", "message.worker.posted", "message.pipeline.posted", "message.system.posted"] },
          "policy_decision_id": { "type": "string" },
          "actor_id": { "type": "string" },
          "actor_type": { "enum": ["human", "agent", "worker", "pipeline", "system"] },
          "actor_display_name": { "type": "string" },
          "actor_role": { "enum": ["operator", "agent", "worker", "pipeline", "system"] },
          "content_type": { "enum": ["text", "card", "action_request", "action_response"] },
          "body": { "type": "string", "minLength": 1 },
          "content_payload": { "type": "string", "minLength": 1 },
          "source_receipt_id": { "type": "string" },
          "source_receipt_kind": { "type": "string" },
          "trusted_context_citation": { "type": "boolean" },
          "trusted_context_source_id": { "type": "string" },
          "trusted_context_receipt_id": { "type": "string" },
          "trusted_context_projection_route": { "const": "/pages/context-sources/projection.json" },
          "outbox_topic": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "minLength": 1 },
          "llm_allowed_on_hot_path": { "const": false },
          "realtime_fanout_allowed": { "const": false },
          "production_write_allowed": { "const": false }
        }
      }
    }
  }
}
