{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageActionVerdictLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "auth_session_tenant_id", "auth_session_user_id", "auth_session_role", "writes_route", "projection_route", "action_verdict_id", "action_verdict_receipt_id", "message_receipt_id", "policy_decision_id", "action_request_receipt_id", "action_request_id", "thread_id", "channel_id", "title", "verdict", "decision_note", "gate_state", "applied_receipt_kind", "applied_receipt_id", "human_decision_recorded", "human_approval_granted", "execution_allowed", "live_substrate_required", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-message-action-verdict-local-post" },
    "status": { "const": "MESSAGE_ACTION_VERDICT_RECORDED_EXECUTION_BLOCKED" },
    "auth_session_required": { "const": true },
    "auth_session_status": { "enum": ["ACCEPTED_LOCAL_STUB", "VERIFIED_TRUSTED_SESSION"] },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "auth_session_tenant_id": { "type": "string", "minLength": 1 },
    "auth_session_user_id": { "type": "string", "minLength": 1 },
    "auth_session_role": { "type": "string", "minLength": 1 },
    "writes_route": { "const": "/messages/action-verdicts.json" },
    "projection_route": { "const": "/messages/action-verdicts/projection.json" },
    "action_verdict_id": { "type": "string", "minLength": 1 },
    "action_verdict_receipt_id": { "type": "string", "minLength": 1 },
    "message_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "action_request_receipt_id": { "type": "string", "minLength": 1 },
    "action_request_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "channel_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["approve", "edit", "reject", "respond"] },
    "decision_note": { "type": "string", "minLength": 1 },
    "gate_state": { "enum": ["GOVERNED_ACTION_APPLIED_EXECUTION_BLOCKED", "VERDICT_RECORDED_NO_ACTION_APPLIED", "ACTION_REQUEST_MISSING", "NO_SUPPORTED_ACTION_BOUND", "ACTION_PAYLOAD_MISSING_BUILD_REQUEST", "ACTION_PAYLOAD_MISSING_BUILD_APPROVAL", "ACTION_PAYLOAD_MISSING_PAGES_APPROVAL_REQUEST", "GOVERNED_ACTION_APPLIED_RECEIPT_MISSING"] },
    "applied_receipt_kind": { "type": "string" },
    "applied_receipt_id": { "type": "string" },
    "human_decision_recorded": { "const": true },
    "human_approval_granted": { "type": "boolean" },
    "execution_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
