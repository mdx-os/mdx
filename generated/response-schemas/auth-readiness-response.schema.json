      "type": "object",
      "additionalProperties": false,
      "required": ["service_role_shortcut_allowed", "user_metadata_authorization_allowed", "implicit_tenant_inference_allowed", "production_role_write_allowed", "production_auth_provider_allowed", "supabase_auth_claim_authority_allowed", "session_cookie_write_allowed", "session_revocation_provider_allowed", "oauth_login_allowed", "password_login_allowed", "cutover_allowed", "production_write_allowed"],
      "properties": {
        "service_role_shortcut_allowed": { "const": false },
        "user_metadata_authorization_allowed": { "const": false },
        "implicit_tenant_inference_allowed": { "const": false },
        "production_role_write_allowed": { "const": false },
        "production_auth_provider_allowed": { "const": false },
        "supabase_auth_claim_authority_allowed": { "const": false },
        "session_cookie_write_allowed": { "const": false },
        "session_revocation_provider_allowed": { "const": false },
        "oauth_login_allowed": { "const": false },
        "password_login_allowed": { "const": false },
        "cutover_allowed": { "const": false },
        "production_write_allowed": { "const": false }
      }
    },
    "source_routes": { "type": "array", "minItems": 9, "items": { "type": "string" } },
    "ui_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_owner", "target_surface", "safe_to_show_local_auth_ready", "safe_to_show_invite_and_role_receipts", "safe_to_show_session_control_receipts", "must_show_production_auth_blocked", "must_show_email_delivery_blocked", "must_show_session_activation_blocked", "must_show_session_revocation_provider_blocked", "must_show_tenant_switch_refusal", "must_show_role_escalation_refusal", "must_not_enable_service_role_shortcut", "must_not_claim_supabase_auth_cutover", "must_not_allow_tenant_switch_without_policy", "must_not_allow_role_escalation_without_policy", "must_keep_local_stub_label_visible"],
      "properties": {
        "target_owner": { "const": "claude" },
        "target_surface": { "const": "apps/mdx Console Access and Session module" },
        "safe_to_show_local_auth_ready": { "type": "boolean" },
        "safe_to_show_invite_and_role_receipts": { "const": true },
        "safe_to_show_session_control_receipts": { "const": true },
        "must_show_production_auth_blocked": { "const": true },
        "must_show_email_delivery_blocked": { "const": true },
        "must_show_session_activation_blocked": { "const": true },
        "must_show_session_revocation_provider_blocked": { "const": true },
        "must_show_tenant_switch_refusal": { "const": true },
        "must_show_role_escalation_refusal": { "const": true },
        "must_not_enable_service_role_shortcut": { "const": true },
        "must_not_claim_supabase_auth_cutover": { "const": true },
        "must_not_allow_tenant_switch_without_policy": { "const": true },
        "must_not_allow_role_escalation_without_policy": { "const": true },
        "must_keep_local_stub_label_visible": { "const": true }
      }
    },
    "checks": { "type": "array", "minItems": 4, "items": { "type": "string" } }
  }
}
