{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinOfficeDownloadLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_route", "route", "runtime_route", "artifact_id", "artifact_kind", "output_ref", "output_hash", "output_bytes", "content_type", "office_generation_receipt_id", "office_download_receipt_id", "policy_decision_id", "download_allowed", "owner_authorized", "output_base64", "raw_private_content_recorded", "provider_call_allowed", "frontier_raw_content_allowed", "memory_write_performed", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-twin-office-download-local-post" },
    "status": { "const": "TWIN_OFFICE_DOWNLOAD_READY_LOCAL" },
    "auth_session_required": { "const": true },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "route": { "const": "/twin/office/downloads.json" },
    "runtime_route": { "const": "/twin/office-capability-runtime.json" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_kind": { "enum": ["docx", "xlsx", "pptx"] },
    "output_ref": { "type": "string", "minLength": 1 },
    "output_hash": { "type": "string", "pattern": "^sha256:" },
    "output_bytes": { "type": "integer", "minimum": 1 },
    "content_type": { "type": "string", "minLength": 1 },
    "office_generation_receipt_id": { "type": "string", "minLength": 1 },
    "office_download_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "download_allowed": { "const": true },
    "owner_authorized": { "const": true },
    "output_base64": { "type": "string", "minLength": 1 },
    "raw_private_content_recorded": { "const": false },
    "provider_call_allowed": { "const": false },
    "frontier_raw_content_allowed": { "const": false },
    "memory_write_performed": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
