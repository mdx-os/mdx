        "status": { "const": "RECORDED" },
        "route": { "const": "/forge/candidate-selections.json" },
        "review_packet_route": { "const": "/forge/review-packet.json" },
        "source_host_pr_draft_route": { "const": "/forge/source-host-pr-drafts.json" },
        "selection_id": { "type": "string", "minLength": 1 },
        "primary_run_id": { "type": "string", "minLength": 1 },
        "selected_run_id": { "type": "string", "minLength": 1 },
        "recommended_run_id": { "type": "string" },
        "candidate_count": { "type": "integer", "minimum": 2 },
        "receipt_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "selected_matches_recommendation": { "type": "boolean" },
        "override_reason_recorded": { "type": "boolean" },
        "selection_grants_delivery_authority": { "const": false },
        "production_write_allowed": { "const": false }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason", "receipt_ids", "selection_grants_delivery_authority", "production_write_allowed"],
      "properties": {
        "name": { "const": "mdx-forge-candidate-selection-local-post" },
        "status": { "const": "REFUSED" },
        "reason": { "type": "string", "minLength": 1 },
        "receipt_ids": { "type": "array", "maxItems": 0 },
        "selection_grants_delivery_authority": { "const": false },
        "production_write_allowed": { "const": false }
      }
    }
  ]
