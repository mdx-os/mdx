    "byte_size": { "type": "integer", "minimum": 1 },
    "download_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "source_artifact_receipt_id": { "type": "string", "minLength": 1 },
    "storage_receipt_id": { "type": "string", "minLength": 1 },
