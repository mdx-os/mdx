{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageThreadMessageLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "auth_session_tenant_id", "auth_session_user_id", "auth_session_role", "writes_route", "projection_route", "thread_id", "channel_id", "message_id", "message_receipt_id", "message_receipt_kind", "policy_decision_id", "actor_type", "actor_role", "content_type", "content_payload", "source_receipt_id", "source_receipt_kind", "trusted_context_citation", "trusted_context_source_id", "trusted_context_receipt_id", "trusted_context_projection_route", "outbox_topic", "sequence", "created_at", "llm_allowed_on_hot_path", "realtime_fanout_allowed", "live_substrate_required", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-message-thread-message-local-post" },
    "status": { "const": "MESSAGE_APPENDED_FANOUT_BLOCKED" },
    "auth_session_required": { "const": true },
    "auth_session_status": { "enum": ["ACCEPTED_LOCAL_STUB", "VERIFIED_TRUSTED_SESSION"] },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "auth_session_tenant_id": { "type": "string", "minLength": 1 },
    "auth_session_user_id": { "type": "string", "minLength": 1 },
    "auth_session_role": { "type": "string", "minLength": 1 },
    "writes_route": { "const": "/messages/thread-messages.json" },
    "projection_route": { "const": "/messages/thread-messages/projection.json" },
    "thread_id": { "type": "string", "minLength": 1 },
    "channel_id": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "minLength": 1 },
    "message_receipt_id": { "type": "string", "minLength": 1 },
    "message_receipt_kind": { "enum": ["message.human.posted", "message.agent.posted", "message.worker.posted", "message.pipeline.posted", "message.system.posted"] },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "actor_type": { "enum": ["human", "agent", "worker", "pipeline", "system"] },
    "actor_role": { "enum": ["operator", "agent", "worker", "pipeline", "system"] },
    "content_type": { "enum": ["text", "card", "action_request", "action_response"] },
    "content_payload": { "type": "string", "minLength": 1 },
    "source_receipt_id": { "type": "string", "minLength": 1 },
    "source_receipt_kind": { "type": "string", "minLength": 1 },
    "trusted_context_citation": { "type": "boolean" },
    "trusted_context_source_id": { "type": "string" },
    "trusted_context_receipt_id": { "type": "string" },
    "trusted_context_projection_route": { "const": "/pages/context-sources/projection.json" },
    "outbox_topic": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "llm_allowed_on_hot_path": { "const": false },
    "realtime_fanout_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
