{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2DeploymentProfileBootstrapResponse",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "mode",
    "status",
    "route",
    "read_only",
    "local_install_ready",
    "local_auth_bootstrap_ready",
    "provider_connected_local_ready",
    "cloud_deployment_allowed_now",
    "deployment_authority_allowed",
    "production_write_allowed",
    "production_cutover_allowed",
    "service_role_runtime_allowed",
    "browser_service_role_allowed",
    "secret_values_recorded",
    "proof_check",
    "route_check",
    "profile_summary",
    "install_paths",
    "profile_bootstraps",
    "deployment_artifacts",
    "blocked_authority",
    "ui_handoff",
    "upstream_packets",
    "source_routes",
    "next_commands",
    "git",
    "evidence_file"
  ],
  "properties": {
    "name": { "const": "mdx-v2-deployment-profile-bootstrap" },
    "mode": { "const": "cloud-agnostic-deployment-bootstrap" },
    "status": { "const": "DEPLOYMENT_PROFILE_BOOTSTRAP_READY_LOCAL_ONLY" },
    "route": { "const": "/v2/deployment-profile-bootstrap.json" },
    "read_only": { "const": true },
    "local_install_ready": { "const": true },
    "local_auth_bootstrap_ready": { "const": true },
    "provider_connected_local_ready": { "type": "boolean" },
    "cloud_deployment_allowed_now": { "const": false },
    "deployment_authority_allowed": { "const": false },
    "production_write_allowed": { "const": false },
    "production_cutover_allowed": { "const": false },
    "service_role_runtime_allowed": { "const": false },
    "browser_service_role_allowed": { "const": false },
    "secret_values_recorded": { "const": false },
    "proof_check": { "const": "make v2-deployment-profile-bootstrap" },
    "route_check": { "const": "make v2-deployment-profile-bootstrap-route-check" },
    "profile_summary": {
      "type": "object",
      "required": ["profile_count", "local_ready_profile_count", "cloud_ready_profile_count", "enterprise_profile_count", "open_source_profile_count", "artifact_scaffold_count", "env_var_count", "auth_lane_count"],
      "properties": {
        "profile_count": { "const": 6 },
        "local_ready_profile_count": { "const": 1 },
        "cloud_ready_profile_count": { "const": 0 },
        "enterprise_profile_count": { "const": 2 },
        "open_source_profile_count": { "const": 1 },
        "artifact_scaffold_count": { "const": 4 },
        "env_var_count": { "type": "integer", "minimum": 30 },
        "auth_lane_count": { "const": 6 }
      }
    },
    "install_paths": {
      "type": "array",
      "minItems": 3,
      "allOf": [
        { "contains": { "type": "object", "required": ["id", "allowed_now"], "properties": { "id": { "const": "local_dev" }, "allowed_now": { "const": true } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "provider_connected_local" } } } },
        { "contains": { "type": "object", "required": ["id", "allowed_now"], "properties": { "id": { "const": "cloud_profile_bootstrap" }, "allowed_now": { "const": false } } } }
      ]
    },
    "profile_bootstraps": {
      "type": "array",
      "minItems": 6,
      "allOf": [
        { "contains": { "type": "object", "required": ["id", "status", "allowed_now"], "properties": { "id": { "const": "local_dev" }, "status": { "const": "READY" }, "allowed_now": { "const": true } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "provider_connected_local" } } } },
        { "contains": { "type": "object", "required": ["id", "allowed_now"], "properties": { "id": { "const": "personal_render_supabase" }, "allowed_now": { "const": false } } } },
        { "contains": { "type": "object", "required": ["id", "allowed_now"], "properties": { "id": { "const": "enterprise_aws_eks_rds" }, "allowed_now": { "const": false } } } },
        { "contains": { "type": "object", "required": ["id", "allowed_now"], "properties": { "id": { "const": "gcp_gke_cloudsql" }, "allowed_now": { "const": false } } } },
        { "contains": { "type": "object", "required": ["id", "status", "allowed_now"], "properties": { "id": { "const": "self_hosted_kubernetes" }, "status": { "const": "PUBLIC_READINESS_REQUIRED" }, "allowed_now": { "const": false } } } }
      ]
    },
    "deployment_artifacts": {
      "type": "array",
      "minItems": 4,
      "allOf": [
        { "contains": { "type": "object", "required": ["id", "status"], "properties": { "id": { "const": "local_compose" }, "status": { "const": "READY" } } } },
        { "contains": { "type": "object", "required": ["id", "status", "path", "deployment_allowed_now"], "properties": { "id": { "const": "render_blueprint" }, "status": { "const": "SCAFFOLD_READY_DEPLOYMENT_BLOCKED" }, "path": { "const": "deploy/render/alpha-render.yaml" }, "deployment_allowed_now": { "const": false } } } },
        { "contains": { "type": "object", "required": ["id", "status", "path", "deployment_allowed_now"], "properties": { "id": { "const": "kubernetes_base" }, "status": { "const": "SCAFFOLD_READY_DEPLOYMENT_BLOCKED" }, "path": { "const": "deploy/kubernetes/base/kustomization.yaml" }, "deployment_allowed_now": { "const": false } } } },
        { "contains": { "type": "object", "required": ["id", "status", "paths", "deployment_allowed_now"], "properties": { "id": { "const": "terraform_profiles" }, "status": { "const": "SCAFFOLD_READY_DEPLOYMENT_BLOCKED" }, "paths": { "type": "array", "contains": { "const": "deploy/terraform/aws-eks-rds/main.tf" } }, "deployment_allowed_now": { "const": false } } } }
      ]
    },
    "blocked_authority": {
      "type": "object",
      "required": ["cloud_deployment_from_plan_allowed", "env_presence_as_deployment_authority_allowed", "service_role_to_browser_allowed", "secret_values_recorded_allowed", "production_write_allowed", "production_cutover_allowed", "provider_call_without_turn_on_receipt_allowed", "real_login_without_tenant_policy_allowed"],
      "properties": {
        "cloud_deployment_from_plan_allowed": { "const": false },
        "env_presence_as_deployment_authority_allowed": { "const": false },
        "service_role_to_browser_allowed": { "const": false },
        "secret_values_recorded_allowed": { "const": false },
        "production_write_allowed": { "const": false },
        "production_cutover_allowed": { "const": false },
        "provider_call_without_turn_on_receipt_allowed": { "const": false },
        "real_login_without_tenant_policy_allowed": { "const": false }
      }
    },
    "ui_handoff": {
      "type": "object",
      "required": ["target_owner", "safe_to_show_profile_bootstrap", "must_show_local_dev_as_default", "must_show_cloud_profiles_blocked", "must_not_enable_deploy_button_from_packet_alone", "must_not_show_secret_values"],
      "properties": {
        "target_owner": { "const": "claude" },
        "safe_to_show_profile_bootstrap": { "const": true },
        "must_show_local_dev_as_default": { "const": true },
        "must_show_cloud_profiles_blocked": { "const": true },
        "must_not_enable_deploy_button_from_packet_alone": { "const": true },
        "must_not_show_secret_values": { "const": true }
      }
    },
    "upstream_packets": {
      "type": "object",
      "required": ["deployment_plan", "alpha_env_contract", "alpha_auth_bootstrap", "provider_connected_local", "deployment_artifacts"],
      "properties": {
        "deployment_plan": { "const": ".mdx-local/v2-deployment-plan.json" },
        "alpha_env_contract": { "const": ".mdx-local/v2-alpha-env-contract.json" },
        "alpha_auth_bootstrap": { "const": ".mdx-local/v2-alpha-auth-bootstrap.json" },
        "provider_connected_local": { "const": ".mdx-local/v2-provider-connected-local.json" },
        "deployment_artifacts": { "const": ".mdx-local/v2-deployment-artifacts.json" }
      }
    },
    "source_routes": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "/v2/deployment-plan.json" } },
        { "contains": { "const": "/v2/alpha-env-contract.json" } },
        { "contains": { "const": "/v2/alpha-auth-bootstrap.json" } },
        { "contains": { "const": "/v2/provider-connected-local.json" } },
        { "contains": { "const": "/v2/deployment-profile-bootstrap.json" } }
      ]
    },
    "next_commands": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "make v2-deployment-artifacts-check" } },
        { "contains": { "const": "make v2-deployment-profile-bootstrap-route-check" } },
        { "contains": { "const": "make public-readiness-check" } },
        { "contains": { "const": "make threat-model-check" } }
      ]
    },
    "evidence_file": { "const": ".mdx-local/v2-deployment-profile-bootstrap.json" }
  }
}