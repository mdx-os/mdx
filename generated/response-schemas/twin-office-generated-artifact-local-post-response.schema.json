{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinOfficeGeneratedArtifactLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_route", "route", "runtime_route", "capability_pack_id", "capability_pack_version", "artifact_id", "artifact_kind", "title", "output_ref", "output_hash", "output_bytes", "content_type", "engine_id", "validation_status", "generation_spec_hash", "office_generation_receipt_id", "policy_decision_id", "download_allowed", "raw_private_content_recorded", "provider_call_allowed", "frontier_raw_content_allowed", "memory_write_performed", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-twin-office-generated-artifact-local-post" },
    "status": { "const": "TWIN_OFFICE_GENERATED_ARTIFACT_CREATED_LOCAL" },
    "auth_session_required": { "const": true },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "route": { "const": "/twin/office/generated-artifacts.json" },
    "runtime_route": { "const": "/twin/office-capability-runtime.json" },
    "capability_pack_id": { "const": "mdx.office.native.v0" },
    "capability_pack_version": { "const": "0.1.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_kind": { "enum": ["docx", "xlsx", "pptx"] },
    "title": { "type": "string", "minLength": 1 },
    "output_ref": { "type": "string", "minLength": 1 },
    "output_hash": { "type": "string", "pattern": "^sha256:" },
    "output_bytes": { "type": "integer", "minimum": 1 },
    "content_type": { "type": "string", "minLength": 1 },
    "engine_id": { "enum": ["docx_openxml_zip", "rust_xlsxwriter", "ppt_rs"] },
    "validation_status": { "const": "OPENXML_PACKAGE_BYTES_PRESENT" },
    "generation_spec_hash": { "type": "string", "pattern": "^sha256:" },
    "office_generation_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "download_allowed": { "const": true },
    "raw_private_content_recorded": { "const": false },
    "provider_call_allowed": { "const": false },
    "frontier_raw_content_allowed": { "const": false },
    "memory_write_performed": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
