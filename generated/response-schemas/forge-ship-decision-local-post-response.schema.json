{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeShipDecisionLocalPostResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "status", "auth_session_required", "auth_session_status", "auth_session_route", "auth_session_tenant_id", "auth_session_user_id", "auth_session_role", "writes_route", "projection_route", "decision", "terminal_state", "decision_receipt_id", "policy_decision_id", "denied_reason", "next_safe_action", "forge_ship_ratified", "ship_authority_allowed", "deployment_authority_granted", "deployment_allowed", "live_substrate_required", "production_write_allowed"],
  "properties": {
    "name": { "const": "mdx-forge-ship-decision-local-post" },
    "status": { "enum": ["SHIP_RATIFIED", "SHIP_REJECTED", "SHIP_REVISION_REQUESTED", "SHIP_TESTS_RERUN_REQUESTED", "SHIP_ESCALATED", "SHIP_DECISION_BLOCKED"] },
    "auth_session_required": { "const": true },
    "auth_session_status": { "enum": ["ACCEPTED_LOCAL_STUB", "VERIFIED_TRUSTED_SESSION"] },
    "auth_session_route": { "const": "/local/auth-session.json" },
    "auth_session_tenant_id": { "type": "string", "minLength": 1 },
    "auth_session_user_id": { "type": "string", "minLength": 1 },
    "auth_session_role": { "type": "string", "minLength": 1 },
    "writes_route": { "const": "/forge/ship-decisions.json" },
    "projection_route": { "const": "/forge/ship-decisions/projection.json" },
    "decision": { "enum": ["ratify", "reject", "request_revision", "rerun_tests", "escalate"] },
    "terminal_state": { "enum": ["SHIP_RATIFIED", "SHIP_REJECTED", "SHIP_REVISION_REQUESTED", "SHIP_TESTS_RERUN_REQUESTED", "SHIP_ESCALATED", "SHIP_DECISION_BLOCKED"] },
    "decision_receipt_id": { "type": "string", "minLength": 1 },
    "policy_decision_id": { "type": "string", "minLength": 1 },
    "denied_reason": { "type": "string" },
    "next_safe_action": { "type": "string", "minLength": 1 },
    "forge_ship_ratified": { "type": "boolean" },
    "ship_authority_allowed": { "type": "boolean" },
    "deployment_authority_granted": { "const": false },
    "deployment_allowed": { "const": false },
    "live_substrate_required": { "const": false },
    "production_write_allowed": { "const": false }
  }
}
