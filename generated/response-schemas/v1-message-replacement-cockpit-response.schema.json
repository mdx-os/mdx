        "external_provider_call_allowed": { "const": false },
        "production_write_allowed": { "const": false },
        "production_cutover_allowed": { "const": false }
      }
    },
    "cutover_blockers": {
      "type": "object",
      "required": ["name", "cutover_green_allowed", "production_write_allowed", "production_cutover_allowed"],
      "properties": {
