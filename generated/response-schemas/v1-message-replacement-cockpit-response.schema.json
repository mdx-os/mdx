    "blocked_authority": {
      "type": "object",
      "required": ["realtime_broadcast_allowed", "presence_mutation_allowed", "typing_state_allowed", "websocket_fanout_allowed", "production_delivery_allowed", "service_role_fanout_allowed", "service_role_runtime_allowed", "provider_call_allowed", "live_provider_turn_on_allowed", "production_write_allowed", "production_cutover_allowed"],
      "properties": {
        "realtime_broadcast_allowed": { "const": false },
        "presence_mutation_allowed": { "const": false },
        "typing_state_allowed": { "const": false },
        "websocket_fanout_allowed": { "const": false },
        "production_delivery_allowed": { "const": false },
        "service_role_fanout_allowed": { "const": false },
        "service_role_runtime_allowed": { "const": false },
        "provider_call_allowed": { "const": false },
        "live_provider_turn_on_allowed": { "const": false },
        "production_write_allowed": { "const": false },
        "production_cutover_allowed": { "const": false }
