{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "migrations", "mode", "live_substrate"],
  "properties": {
    "name": { "const": "mdx-native local" },
    "migrations": { "type": "integer", "minimum": 0 },
    "mode": { "const": "deterministic-local" },
    "live_substrate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "substrate",
          "local_adapter",
          "live_adapter",
          "status",
          "turn_on_signal",
          "blocking_rails",
          "first_local_proof"
        ],
        "properties": {
          "substrate": { "type": "string" },
          "local_adapter": { "type": "string" },
          "live_adapter": { "type": "string" },
          "status": { "enum": ["PENDING-LIVE-RUN", "LIVE-LOCAL"] },
          "turn_on_signal": { "type": "string" },
          "blocking_rails": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "first_local_proof": { "type": "string" }
        }
      }
    }
  }
}
