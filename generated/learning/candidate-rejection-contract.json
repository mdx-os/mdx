{
  "name": "mdx-learning-candidate-rejection-contract",
  "mode": "deterministic-local",
  "source": "docs/MDX-LEARNING-LOOP.md",
  "status": "GOVERNED_WRITE_V0",
  "purpose": "Define Learn's governed candidate rejection: record the accountable no on a drafted lesson candidate with a receipt that cites the source receipt in the ledger, so rejection is signal rather than silence and the candidate leaves the draft lane without deleting history.",
  "writes_route": "/learning/candidate-rejections.json",
  "projection_route": "/learning/candidate-rejections/projection.json",
  "receipt_kind": "learning.candidate.rejected",
  "required_fields": [
    "candidate_rejection_id",
    "candidate_id",
    "source_receipt_id",
    "source_receipt_kind",
    "actor_id",
    "reason",
    "review_owner",
    "lane_state",
    "candidate_rejection_receipt_id",
    "policy_decision_id"
  ],
  "valid_source_receipt_kinds": [
    "forge.outcome.signal.recorded",
    "beta.feedback.captured",
    "forge.run.event",
    "learning.implicit.signal"
  ],
  "reader_effect": "the draft candidate projection excludes any candidate whose source receipt carries a rejection, so a rejected candidate never reappears for re-drafting while its receipts stay visible.",
  "v0_boundaries": {
    "records_rejection": true,
    "excludes_source_from_drafts": true,
    "deletes_receipts": false,
    "writes_memory": false,
    "refreshes_generated_artifacts": false,
    "writes_provider_memory": false,
    "updates_scorecards": false,
    "applies_adaptation": false,
    "changes_model_routing": false,
    "changes_fleet_casting": false,
    "changes_check_policy": false,
    "changes_budget": false,
    "changes_review_depth": false,
    "changes_runtime_behavior": false,
    "requires_source_receipt_in_ledger": true,
    "refuses_double_rejection": true,
    "requires_reason": true,
    "requires_review_owner": true,
    "requires_actor_admission": true,
    "requires_receipt": true,
    "production_write_allowed": false
  },
  "checks": ["make learning-loop-check", "make local-smoke"]
}
