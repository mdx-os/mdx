{
  "name": "mdx-learning-memory-supersede-contract",
  "mode": "deterministic-local",
  "source": "docs/MDX-LEARNING-LOOP.md",
  "status": "GOVERNED_WRITE_V0",
  "purpose": "Define Learn's governed memory supersede gate: retire an activated MDx memory with a receipt that cites the activation receipt in the ledger, so a wrong lesson stops guiding later work without deleting its history.",
  "writes_route": "/learning/memory-supersedes.json",
  "projection_route": "/learning/memory-supersedes/projection.json",
  "receipt_kind": "learning.memory.superseded",
  "required_fields": [
    "memory_supersede_id",
    "activation_receipt_id",
    "active_memory_id",
    "actor_id",
    "reason",
    "review_owner",
    "active_memory_state",
    "memory_supersede_receipt_id",
    "policy_decision_id"
  ],
  "reader_effect": "assemble_context, the memory activation projection, and flywheel proof treat a superseded lesson as retired: it stops informing new runs while its receipts stay visible.",
  "v0_boundaries": {
    "retires_active_memory": true,
    "deletes_receipts": false,
    "hides_superseded_records": false,
    "refreshes_generated_artifacts": false,
    "writes_provider_memory": false,
    "updates_scorecards": false,
    "applies_adaptation": false,
    "changes_model_routing": false,
    "changes_fleet_casting": false,
    "changes_check_policy": false,
    "changes_budget": false,
    "changes_review_depth": false,
    "changes_prompt_shape": false,
    "changes_guardrails": false,
    "changes_runtime_behavior": false,
    "requires_activation_receipt_in_ledger": true,
    "refuses_double_supersede": true,
    "requires_reason": true,
    "requires_review_owner": true,
    "requires_actor_admission": true,
    "requires_receipt": true,
    "production_write_allowed": false
  },
  "checks": ["make learning-loop-check", "make local-smoke"]
}
