{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdx.local/contracts/worker-credential-check.schema.json",
  "title": "MDx Worker Credential Check",
  "type": "object",
  "required": [
    "worker_template_id",
    "eval_credential_id",
    "credential_receipt_id",
    "capability_scope",
    "expires_at",
    "issuer_loop_id",
    "requested_receipt_kind"
  ],
  "properties": {
    "worker_template_id": { "type": "string" },
    "eval_credential_id": { "type": "string" },
    "credential_receipt_id": { "type": "string" },
    "capability_scope": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "issuer_loop_id": { "type": "string", "const": "evals_runner_agent" },
    "requested_receipt_kind": { "type": "string", "const": "worker.credential.checked" }
  },
  "additionalProperties": false
}
