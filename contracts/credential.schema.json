{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdx.local/contracts/credential.schema.json",
  "title": "MDx Eval Credential",
  "type": "object",
  "required": ["credential_id", "tenant_id", "actor_id", "eval_verdict_id", "status"],
  "properties": {
    "credential_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "actor_id": { "type": "string" },
    "eval_verdict_id": { "type": "string" },
    "status": { "enum": ["MINTED", "RENEWED", "WITHHELD"] }
  }
}

